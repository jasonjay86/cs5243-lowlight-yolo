# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Datasets. Everything under data/ is generated or downloaded, except the
# frozen split manifest and its summary, which are tracked on purpose.
data/*
!data/README.md
!data/cct20_splits/
!data/cct20_splits/*.csv
!data/cct20_splits/*.json

# Model weights. Use external storage or Git LFS if a weight must be shared.
*.pt
*.pth
*.onnx
*.weights
**/weights/
!enhancements/*/weights/.gitkeep

# YOLO training output
runs/
wandb/

# Per-run artefacts. The numbers stay; the big files regenerate.
experiments/*/predictions/
experiments/*/logs/
experiments/*/checkpoints/
experiments/*/*.png
experiments/*/*.pdf
!experiments/.gitkeep

# Sampled-run figures
results/figures/*.png
results/figures/*.pdf
!results/figures/.gitkeep

# Slurm logs
logs/
info.*

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Secrets
.env
.env.local
